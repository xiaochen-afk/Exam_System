<import src="../../shared/ui.wxml" />

<view class="shell">
  <template is="preview" data="{{preview: preview}}" />
  <view class="page-head">
    <text class="detail-title" aria-role="heading">{{title}}</text>
    <text wx:if="{{mode === 'tickets'}}" class="body">选择报名场次，查看已开放的准考证。</text>
    <text wx:if="{{mode === 'scores'}}" class="body">这里显示已发布的本人考试成绩。</text>
  </view>
  <block wx:if="{{state === 'ready'}}">
    <view wx:if="{{items.length}}" class="stack">
      <block wx:if="{{mode === 'scores'}}">
        <view wx:for="{{items}}" wx:key="id" class="surface panel score-card">
          <view class="card-main">
            <text class="badge badge-green">已发布</text>
            <text class="card-title score-title">{{item.sessionName}}</text>
            <text class="caption">{{item.publishedTime}} 发布</text>
          </view>
          <view class="score"><text class="score-number">{{item.score}}</text><text class="caption">分</text></view>
        </view>
      </block>
      <block wx:elif="{{mode === 'messages'}}">
        <view wx:for="{{items}}" wx:key="id" class="surface panel">
          <text class="card-title">{{item.title}}</text><text class="body">{{item.summary}}</text>
        </view>
      </block>
      <block wx:else>
        <navigator wx:for="{{items}}" wx:key="id" class="surface panel record-card tappable" hover-class="none"
          url="{{mode === 'tickets' ? '/pages/ticket/ticket?id=' + item.id : '/pages/record-detail/record-detail?id=' + item.id}}">
          <view class="card-main">
            <view class="card-meta record-top"><text wx:if="{{mode === 'registrations'}}" class="badge badge-green">已报名</text><text class="caption">{{item.examTime}}</text></view>
            <text class="card-title">{{item.sessionName}}</text>
            <text class="caption">{{item.siteName}}</text>
          </view>
          <view class="chevron"></view>
        </navigator>
      </block>
    </view>
    <page-feedback wx:else state="empty" message="{{empty}}" />
    <template is="more" data="{{hasMore: hasMore, loadingMore: loadingMore, moreError: moreError}}" />
  </block>
  <block wx:else><page-feedback state="{{state}}" message="{{message}}" request-id="{{requestId}}" bind:retry="refresh" /></block>
</view>
