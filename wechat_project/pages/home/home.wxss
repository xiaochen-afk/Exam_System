.home-shell { padding-top: 16rpx; }
.hero { position: relative; background: var(--canvas); }
.hero-image { display: block; width: 100%; }
.hero-copy { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 18rpx 36rpx; }
.hero-title { display: block; color: var(--ink); font-size: 66rpx; font-weight: 760; letter-spacing: -3rpx; line-height: 1.18; }
.hero-desc { display: block; margin-top: 14rpx; color: var(--muted); font-size: 25rpx; }
.hero-button { display: inline-flex; align-items: center; justify-content: center; min-height: 70rpx; margin-top: 28rpx; gap: 12rpx; padding: 0 24rpx; border: 1rpx solid rgba(255,255,255,.97); background: rgba(255,255,255,.87); border-radius: 99rpx; color: var(--blue-strong); font-size: 25rpx; font-weight: 700; backdrop-filter: blur(10px); }
.hero-button .chevron { width: 10rpx; height: 10rpx; border-color: var(--blue); }
.shortcuts { display: flex; justify-content: space-around; margin-top: 20rpx; padding: 20rpx 8rpx; }
.shortcut { flex: 1; min-width: 0; display: flex; align-items: center; flex-direction: column; gap: 12rpx; padding: 4rpx 0; font-size: 23rpx; font-weight: 650; }
