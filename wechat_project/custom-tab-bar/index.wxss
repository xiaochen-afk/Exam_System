.dock {
  position: fixed; z-index: 10; left: 28rpx; right: 28rpx;
  bottom: 16rpx; bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex; align-items: center; gap: 5rpx;
  max-width: 740rpx; box-sizing: border-box; margin: auto; padding: 8rpx;
  border: 1rpx solid rgba(224,232,245,.9); border-radius: 60rpx;
  background: rgba(255,255,255,.94); backdrop-filter: blur(20px) saturate(1.3);
  box-shadow: 0 8rpx 36rpx rgba(36,65,119,.14), inset 0 -1rpx 2rpx rgba(101,133,188,.13);
}
.tab { display: flex; flex: 1; min-width: 0; min-height: 86rpx; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; border-radius: 50rpx; color: #54637a; font-size: 21rpx; line-height: 1.2; }
.tab.active { background: #edf3fe; color: #075ccd; font-weight: 700; }
.tab-icon { width: 43rpx; height: 43rpx; }
