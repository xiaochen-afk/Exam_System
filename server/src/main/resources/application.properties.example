# Copy to application.properties and fill in the MySQL username and password.
# The local application.properties file is ignored by Git.
spring.application.name=exam-system-server

# Private filesystem root; attachment storage keys are relative and use forward slashes.
app.portal.attachment-root=./storage/notice-attachments
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=11MB

spring.datasource.url=jdbc:mysql://localhost:3306/exam_system?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.datasource.hikari.connection-init-sql=SET time_zone = '+00:00'
mybatis-plus.configuration.map-underscore-to-camel-case=true
# SQL parameters can contain password hashes and personal fields, even at DEBUG level.
mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.nologging.NoLoggingImpl
mybatis-plus.mapper-locations=classpath*:mapper/**/*.xml
mybatis-plus.global-config.db-config.id-type=auto
mybatis-plus.global-config.banner=false
spring.jackson.deserialization.fail-on-unknown-properties=true
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax
server.servlet.session.tracking-modes=cookie
server.error.include-message=never
server.error.include-stacktrace=never

# SLF4J / Logback: requestId is generated by the server and cleared after each request.
logging.level.com.examsystem=INFO
logging.pattern.level=%5p [requestId=%X{requestId:-none}]

# 微信小程序认证，仅在后端填写。留空时微信登录返回 WECHAT_NOT_CONFIGURED。
app.wechat.app-id=
app.wechat.app-secret=
