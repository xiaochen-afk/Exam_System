<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.examsystem.common.sql.PaginationSql">
    <!-- size / offset 由 PageQuery 校验、计算；排序必须由各业务查询明确给出。 -->
    <sql id="limitOffset">LIMIT #{size} OFFSET #{offset}</sql>
</mapper>
