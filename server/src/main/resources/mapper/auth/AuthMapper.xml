<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.examsystem.auth.mapper.AuthMapper">
    <!-- 1. 普通读取和插入由 BaseMapper 提供，这里仅保留要求事务行锁的账号投影。 -->
    <sql id="accountById">
        SELECT <include refid="com.examsystem.auth.mapper.AuthSql.accountColumns"/>
        FROM app_user WHERE id = #{id}
    </sql>
    <select id="lockUser" resultType="com.examsystem.auth.model.AuthData$User">
        <include refid="accountById"/> FOR UPDATE
    </select>
    <!-- 2. 单账号和批量账号读取共用有效授权定义。空列表必须返回空，不能放宽范围。 -->
    <select id="actions" resultType="com.examsystem.auth.model.AuthData$GrantAction">
        SELECT <include refid="com.examsystem.auth.mapper.AuthSql.grantColumns"/>
        FROM <include refid="com.examsystem.auth.mapper.AuthSql.grantTables"/>
        WHERE g.staff_id = #{id}
          AND <include refid="com.examsystem.auth.mapper.AuthSql.activeGrant"/>
        ORDER BY g.id, gp.permission_code
    </select>
    <select id="actionsForUsers" resultType="com.examsystem.auth.model.AuthData$OwnedGrantAction">
        SELECT g.staff_id, <include refid="com.examsystem.auth.mapper.AuthSql.grantColumns"/>
        FROM <include refid="com.examsystem.auth.mapper.AuthSql.grantTables"/>
        WHERE <include refid="com.examsystem.auth.mapper.AuthSql.activeGrant"/>
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                AND g.staff_id IN
                <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
            </when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
        ORDER BY g.staff_id, g.id, gp.permission_code
    </select>
</mapper>
